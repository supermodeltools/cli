    "recommendedTaskShape": "Apply the PR's test additions to the base checkout, withhold the production fix, run the focused verifier, then ask the agent to repair without seeing the reference patch.",
    "primaryMetrics": [
      "success",
      "file-level F1 against reference PR production files",
      "time",
      "tool calls",
      "input tokens",
      "output tokens",
      "reasoning tokens",
      "time to first reference file"
    ]
